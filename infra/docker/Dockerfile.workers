# Worker runtime image for Verkli BullMQ workers.
# Build from repo root: docker build -f infra/docker/Dockerfile.workers .
# Run one worker: docker run --env-file .env ... verkli-worker WORKER=import
# Each worker is runnable independently by overriding CMD with WORKER=<name>.

FROM node:20-alpine AS base
WORKDIR /app

# ffmpeg is a hard runtime dependency of the audiobook worker (chapter stitching,
# scripts/audiobook-worker.ts) and the trailer renderer.
#
# It must come from the system, not from the `ffmpeg-static` npm package: the
# install below runs `npm ci --ignore-scripts`, which suppresses ffmpeg-static's
# postinstall step — the step that actually downloads the binary. Without this
# apk line the audiobook worker silently degrades every whole-book job to
# manifest-only output and writes a .json path into audiobook_assets.audio_path,
# while still reporting success.
RUN apk add --no-cache ffmpeg
ENV FFMPEG_BIN=/usr/bin/ffmpeg

# Copy workspace and package files
COPY package.json package-lock.json* ./
COPY apps/web/package.json apps/web/
COPY packages/db/package.json packages/db/
COPY packages/shared/package.json packages/shared/

RUN npm ci --ignore-scripts

# Copy source needed for workers (apps/web + packages)
COPY apps/web apps/web
COPY packages/db packages/db
COPY packages/shared packages/shared

WORKDIR /app/apps/web

# Drop root. These workers parse attacker-supplied content as their whole job —
# EPUB uploads through epub/adm-zip in import-worker, and ffmpeg over generated
# media — while holding SUPABASE_SERVICE_ROLE_KEY in their environment. As root
# any RCE in that chain is a writable, RLS-bypassing foothold; as uid 1001 it is
# a crashed process. Mirrors Dockerfile.web:196.
#
# `-G nodejs` puts worker in the group, so the `:nodejs` half of the chown below
# actually grants something rather than relying on owner bits alone.
#
# Every worker temp path derives from os.tmpdir() (import-worker.ts:174,678 and
# audiobook-worker.ts:522,955), and /tmp is 1777 on Alpine, so nothing here
# needs write access under /app. The chown is kept anyway because this image
# cannot be built and started in the current environment; it costs a duplicated
# layer and buys certainty. Drop it once a real `docker run` confirms the
# workers boot without it.
RUN addgroup -g 1001 -S nodejs && adduser -S worker -u 1001 -G nodejs \
  && chown -R worker:nodejs /app

USER worker

# Default: run import worker. Override in compose with command or WORKER env.
ENV WORKER=import
# Direct path rather than `npx`: tsx hoists to the workspace root, so it lives
# at /app/node_modules/.bin/tsx even though WORKDIR is /app/apps/web. Calling it
# absolutely skips the npm process entirely — no cache or $HOME dependency — and
# `exec` makes tsx PID 1 so Railway's SIGTERM reaches the BullMQ worker instead
# of stopping at the shell, letting it finish the job in hand before exiting.
CMD ["sh", "-c", "exec /app/node_modules/.bin/tsx scripts/${WORKER}-worker.ts"]
