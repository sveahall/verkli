# Recommendations worker - runnable independently.
# Build from repo root: docker build -f infra/docker/Dockerfile.worker.recommendations .
FROM node:22-alpine AS base
WORKDIR /app
COPY package.json package-lock.json* ./
COPY apps/web/package.json apps/web/
COPY packages/db/package.json packages/db/
COPY packages/shared/package.json packages/shared/
COPY infra/docker/check-worker-runtime.cjs infra/docker/
RUN npm ci --ignore-scripts && node infra/docker/check-worker-runtime.cjs
COPY apps/web apps/web
COPY packages/db packages/db
COPY packages/shared packages/shared
WORKDIR /app/apps/web
CMD ["npx", "tsx", "scripts/recommendations-worker.ts"]
