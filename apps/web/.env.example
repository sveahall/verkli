# ─── Public (NEXT_PUBLIC_* = exposed to client) ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Server only (never use in client components) ───
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── Analytics (FAS 2) ───
# Salt for HMAC of IP; omit to leave ip_hash null
# ANALYTICS_IP_SALT=your-secret-salt-min-16-chars

# ─── Admin (metrics endpoint) ───
# ADMIN_API_KEY=your-admin-api-key

# ─── Optional: Waitlist mode ───
# NEXT_PUBLIC_WAITLIST_ONLY=false

# ─── Billing (FAS 3) – om dessa saknas är billing inaktiverat ───
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_PRO_WRITER=price_...
# STRIPE_SUCCESS_URL=https://yourdomain.com/account/billing?success=1
# STRIPE_CANCEL_URL=https://yourdomain.com/account/billing?canceled=1
